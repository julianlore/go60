                            &trans  &to LAYER_Base          &kp F12                                                                                                  &trans            &trans           &trans
                                                                                &kp RET  &kp SPACE  &kp F22  &kp F22  &tog LAYER_Nav_enter  &kp DEL
            >;
        };

    };
};
